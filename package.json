{
  "name": "crypto-wallet-core",
  "description": "A multi-currency support library for address derivation, private key creation, and transaction creation",
  "version": "1.0.0",
  "author": "",
  "main": "build/src/server.js",
  "bin": "bin/start",
  "module": "commonjs",
  "scripts": {
    "start": "npm run compile && node build/src/server.js",
    "debug": "npm run compile && node --inspect build/src/server.js --DEBUG true",
    "clean": "rm -rf build",
    "protobuf": "./protobuf.sh",
    "compile": "npm run protobuf && npm run tsc && cp -r proto build/",
    "docs:build-html": "typedoc --out ./docs/html --tsconfig tsconfig.json ./src",
    "docs:build-json": "typedoc --json ./docs/json --tsconfig tsconfig.json ./src",
    "tsc": "npm run clean && ./node_modules/.bin/tsc",
    "test": "jest --config ./jest.config.json -i",
    "test:ci": "npm run test",
    "test:ci:integration": "npm run test:integration",
    "api": "npm run tsc && node build/src/workers/api.js",
    "api:cluster": "npm run tsc && node build/src/workers/api.js --CLUSTER true",
    "pruning": "npm run tsc && node build/src/workers/pruning.js --EXIT true"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.14.4",
    "@types/elliptic": "^6.4.12",
    "@types/express": "^4.11.1",
    "@types/jest": "^26.0.23",
    "@types/koa-compose": "^3.2.5",
    "@types/lodash": "^4.14.116",
    "@types/mocha": "^5.2.0",
    "@types/mongodb": "^3.1.22",
    "@types/mongoose": "^5.0.11",
    "@types/node": "^10.14.12",
    "@types/request": "^2.47.0",
    "@types/request-promise": "^4.1.39",
    "@types/sinon": "^4.3.3",
    "@types/through2": "^2.0.33",
    "babel-jest": "^27.0.2",
    "barrelsby": "^2.2.0",
    "eslint": "^4.19.1",
    "eslint-config-airbnb-base": "^12.1.0",
    "eslint-plugin-import": "^2.8.0",
    "est": "^0.2.1-alpha",
    "glob": "^7.1.2",
    "jest": "^27.0.4",
    "sinon": "^4.4.8",
    "supertest": "^3.0.0",
    "ts-jest": "^27.0.3",
    "typescript": "^4.3.2",
    "typescript-eslint-parser": "^15.0.0"
  },
  "dependencies": {
    "@binance-chain/javascript-sdk": "^2.14.7",
    "@bitgo/utxo-lib": "https://gitpkg.now.sh/cryptoless/BitGoJS/modules/utxo-lib?multi-steps",
    "@clover-network/node-types": "^1.0.4",
    "@edgeware/node-types": "^3.5.1-erup-4",
    "@ethereumjs/tx": "^3.1.2",
    "@grpc/grpc-js": "^1.3.2",
    "@grpc/proto-loader": "^0.6.2",
    "@polkadot/api": "^4.12.1",
    "@polkadot/keyring": "^3.7.1",
    "abi-decoder": "^2.4.0",
    "bignumber.js": "^8.1.1",
    "bip66": "^1.1.5",
    "bitcoinjs-lib": "^5.0.5",
    "blockstack": "^19.2.1",
    "body-parser": "^1.18.3",
    "c32check": "0.0.6",
    "coinselect": "^3.1.12",
    "cors": "^2.8.4",
    "dotenv": "^9.0.2",
    "elliptic": "^6.5.4",
    "ethereumjs-abi": "^0.6.8",
    "ethereumjs-util": "^7.0.10",
    "express": "^4.16.3",
    "heapdump": "^0.3.15",
    "koa-compose": "^4.1.0",
    "lodash": "^4.17.21",
    "ontology-ts-sdk": "^1.1.0",
    "progress": "^2.0.0",
    "protobufjs": "^6.11.2",
    "request": "^2.88.0",
    "request-promise": "^4.2.4",
    "rlp": "^2.2.6",
    "rxjs": "^6.1.0",
    "secp256k1": "^3.5.0",
    "snappy": "^6.0.1",
    "through2": "^2.0.3",
    "underscore": "^1.8.3",
    "uuid": "^8.3.2",
    "web3": "^1.3.5",
    "winston": "^2.3.9"
  }
}

{
  "name": "otter-js",
  "description": "A multi-currency support library for address derivation, private key creation, and transaction creation",
  "version": "1.0.0",
  "author": "",
  "main": "build/src/server.js",
  "bin": "bin/start",
  "module": "commonjs",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "start": "pnpm run compile && node build/src/server.js",
    "debug": "pnpm run compile && node --inspect build/src/server.js --DEBUG true",
    "clean": "rm -rf build",
    "protobuf": "./protobuf.sh",
    "compile": "pnpm run protobuf && pnpm run tsc && cp -r proto build/",
    "docs:build-html": "typedoc --out ./docs/html --tsconfig tsconfig.json ./src",
    "docs:build-json": "typedoc --json ./docs/json --tsconfig tsconfig.json ./src",
    "tsc": "pnpm run clean && pnpm exec tsc --project ./tsconfig.json && pnpm exec tsc-alias -p tsconfig.json",
    "test": "PORT=14000 GRPC_PORT=60051 jest --config ./jest.config.js -i",
    "test:ci": "pnpm run test",
    "test:ci:integration": "pnpm run test:integration",
    "api": "pnpm run tsc && node build/src/workers/api.js",
    "api:cluster": "pnpm run tsc && node build/src/workers/api.js --CLUSTER true",
    "pruning": "pnpm run tsc && node build/src/workers/pruning.js --EXIT true"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@babel/preset-env": "^7.20.2",
    "@types/ajv-merge-patch": "^4.1.1",
    "@types/cors": "^2.8.12",
    "@types/create-hash": "^1.2.2",
    "@types/dotenv": "^8.2.0",
    "@types/elliptic": "^6.4.12",
    "@types/express": "^4.11.1",
    "@types/jest": "^29.2.2",
    "@types/koa-compose": "^3.2.5",
    "@types/lodash": "4.14.177",
    "@types/lru-cache": "^5.1.1",
    "@types/morgan": "^1.9.3",
    "@types/node": "^10.14.12",
    "@types/request": "^2.47.0",
    "@types/request-promise": "^4.1.39",
    "babel-jest": "^29.3.0",
    "barrelsby": "^2.2.0",
    "eslint": "^8.6.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.8.0",
    "est": "^0.2.1-alpha",
    "glob": "^7.1.2",
    "jest": "^29.3.0",
    "sinon": "^4.4.8",
    "supertest": "^3.0.0",
    "ts-jest": "^29.0.3",
    "tsc-alias": "^1.5.0",
    "typescript": "4.5.2",
    "typescript-eslint-parser": "^15.0.0"
  },
  "dependencies": {
    "@clover-network/node-types": "^1.0.4",
    "@cosmjs/amino": "^0.27.0",
    "@cosmjs/crypto": "^0.27.0",
    "@cosmjs/encoding": "^0.27.0",
    "@cosmjs/proto-signing": "^0.27.0",
    "@cosmjs/stargate": "^0.27.0",
    "@nivek3/utxo-lib": "2.1.0",
    "@edgeware/node-types": "^3.6.2-wako",
    "@ethereumjs/util": "^8.0.4",
    "@ethersproject/bytes": "^5.5.0",
    "@ethersproject/hash": "^5.5.0",
    "@gnosis.pm/safe-deployments": "^1.8.0",
    "@grpc/grpc-js": "^1.8.13",
    "@grpc/proto-loader": "^0.7.5",
    "@mycrypto/gas-estimation": "^1.1.1",
    "@polkadot/api": "^6.4.2",
    "@solana/spl-token": "^0.1.6",
    "@solana/web3.js": "^1.22.0",
    "abi-decoder": "^2.4.0",
    "ajv": "^8.6.2",
    "ajv-errors": "^3.0.0",
    "ajv-merge-patch": "^5.0.1",
    "avalanche": "^3.9.0",
    "bignumber.js": "^8.1.1",
    "bip66": "^1.1.5",
    "bn.js": "^5.2.0",
    "body-parser": "^1.18.3",
    "bs58": "^4.0.1",
    "c32check": "0.0.6",
    "coinselect": "^3.1.12",
    "cors": "^2.8.4",
    "dotenv": "^9.0.2",
    "elliptic": "^6.5.4",
    "ethers": "^5.7.2",
    "express": "^4.16.3",
    "hash.js": "^1.1.7",
    "heapdump": "^0.3.15",
    "koa-compose": "^4.1.0",
    "lodash": "^4.17.21",
    "lru-cache": "^6.0.0",
    "morgan": "^1.10.0",
    "progress": "^2.0.0",
    "request": "^2.88.0",
    "request-promise": "^4.2.4",
    "ripple-address-codec": "^4.1.3",
    "ripple-lib": "^1.9.7",
    "rlp": "^2.2.6",
    "rxjs": "^6.1.0",
    "secp256k1": "^3.5.0",
    "snappy": "^6.0.1",
    "tronweb": "^3.2.7",
    "uuid": "^8.3.2",
    "winston": "^2.3.9",
    "winston-daily-rotate-file": "^3.10.0"
  }
}

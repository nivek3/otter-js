syntax = "proto3";

package account;
option go_package = "./account";
import "common.proto";

message DeployAccountPayload {
    repeated string keys = 1;
    
    int32 requiredConfirmations = 2;
}

message DeployAccountRequest {
    DeployAccountPayload payload = 1;
    NetWork network = 2;
}

message DeployAccountResponse {
    string address = 1;
}

service Account {
    rpc DeployAccount(DeployAccountRequest) returns (DeployAccountResponse) {}
}
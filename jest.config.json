{
    "bail": false,
    "verbose": true,
    "moduleFileExtensions": [
        "ts",
        "js",
        "json"
    ],
    "transform": {
        "^.+\\.jsx?$": "babel-jest",
        "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "transformIgnorePatterns": [
        "node_modules/(?!@polkadot)/"
    ],
    "testMatch": [
        "**/test/**/*.test.(ts|js)"
    ],
    "testEnvironment": "node"
}